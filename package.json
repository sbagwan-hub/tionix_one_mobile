{
  "name": "AttendanceApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run sync:fonts && expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "postinstall": "npm run sync:fonts",
    "sync:fonts": "mkdir -p assets/fonts android/app/src/main/assets/fonts && cp node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf assets/fonts/ionicons.ttf && cp assets/fonts/ionicons.ttf android/app/src/main/assets/fonts/ionicons.ttf",
    "start": "expo start",
    "start:reset": "expo start -c",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-config": "~54.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-file-system": "^56.0.8",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-sharing": "^56.0.17",
    "geolib": "^3.3.14",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "^0.5.1",
    "twrnc": "^4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.76.8",
    "@react-native/typescript-config": "0.76.8",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.10",
    "@types/react-native-maps": "^0.24.1",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
